      "roundness": null,
      "seed": 864171,
      "version": 1,
      "versionNonce": 872090,
      "isDeleted": false,
      "updated": 1791774349375,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "ASHRAE 170\nventilación en instalaciones\nsanitarias: renovaciones/hora,\npresión diferencial, filtración",
      "originalText": "ASHRAE 170\nventilación en instalaciones\nsanitarias: renovaciones/hora,\npresión diferencial, filtración",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ashrae",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "iso-t",
      "type": "text",
      "x": 450,
      "y": 168,
      "width": 320,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "0c",
      "roundness": null,
      "seed": 880009,
      "version": 1,
      "versionNonce": 887928,
      "isDeleted": false,
      "updated": 1791774349375,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "ISO 14644\nsalas limpias: conteo de\npartículas por clase y\ncontrol de contaminación",
      "originalText": "ISO 14644\nsalas limpias: conteo de\npartículas por clase y\ncontrol de contaminación",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "iso",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "cap-crit",
      "type": "text",
      "x": 60,
      "y": 280,
      "width": 308,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "0d",
      "roundness": null,
      "seed": 895847,
      "version": 1,
      "versionNonce": 903766,
      "isDeleted": false,
      "updated": 1791774349375,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "SE DERIVAN CUATRO CRITERIOS DE SELECCIÓN",
      "originalText": "SE DERIVAN CUATRO CRITERIOS DE SELECCIÓN",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "c1-t",
      "type": "text",
      "x": 70,
      "y": 350.5,
      "width": 310,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "0e",
      "roundness": null,
      "seed": 911685,
      "version": 1,
      "versionNonce": 919604,
      "isDeleted": false,
      "updated": 1791774349375,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "1 · Señal estándar industrial\nlazo de corriente 4–20 mA\n\nInmune al ruido electromagnético\ny a las caídas de tensión por\nlongitud de cable.",
      "originalText": "1 · Señal estándar industrial\nlazo de corriente 4–20 mA\n\nInmune al ruido electromagnético\ny a las caídas de tensión por\nlongitud de cable.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c1",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "c2-t",
      "type": "text",
      "x": 440,
      "y": 350.5,
      "width": 310,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "0f",
      "roundness": null,
      "seed": 927523,
      "version": 1,
      "versionNonce": 935442,
      "isDeleted": false,
      "updated": 1791774349375,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "2 · Detección de fallo\ncorriente < 4 mA → rotura de\ncable o fallo del sensor\n\nNAMUR NE 43: < 3,6 mA",
      "originalText": "2 · Detección de fallo\ncorriente < 4 mA → rotura de\ncable o fallo del sensor\n\nNAMUR NE 43: < 3,6 mA",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c2",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "c3-t",
      "type": "text",
      "x": 810,
      "y": 350.5,
      "width": 310,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "0g",
      "roundness": null,
      "seed": 943361,
      "version": 1,
      "versionNonce": 951280,
      "isDeleted": false,
      "updated": 1791774349375,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "3 · Hermeticidad química\ncarcasa IP65 o superior\n\nApta para limpieza con\nagentes desinfectantes.",
      "originalText": "3 · Hermeticidad química\ncarcasa IP65 o superior\n\nApta para limpieza con\nagentes desinfectantes.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c3",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "c4-t",
      "type": "text",
      "x": 440,
      "y": 510.5,
      "width": 310,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "0h",
      "roundness": null,
      "seed": 959199,
      "version": 1,
      "versionNonce": 967118,
      "isDeleted": false,
      "updated": 1791774349375,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "4 · Compatibilidad con OpenPLC\nmódulo de entrada analógica\no comunicación Modbus TCP/RTU\n\nSin adaptadores propietarios.",
      "originalText": "4 · Compatibilidad con OpenPLC\nmódulo de entrada analógica\no comunicación Modbus TCP/RTU\n\nSin adaptadores propietarios.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c4",
      "lineHeight": 1.25,
      "autoResize": true
    },
